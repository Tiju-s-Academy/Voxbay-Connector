<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_case_kanban_view_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_kanban_content')]" position="inside">
                <div t-if="record.has_unread_whatsapp.raw_value" class="float-end badge text-bg-info">
                    <i class="fa fa-whatsapp" title="New WhatsApp Message"/> 
                </div>
            </xpath>
        </field>
    </record>
</odoo>
